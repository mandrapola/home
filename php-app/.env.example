APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenWrt package downloads
OPENWRT_DOWNLOAD_BASE_URL=/downloads/openwrt
OPENWRT_PACKAGE_NAME=home-aidvor
OPENWRT_PACKAGE_VERSION=24.10.5

# Proxy -> server HMAC verification
PROXY_HMAC_REQUIRED=false
PROXY_HMAC_PROXY_ID=getaway
PROXY_HMAC_SECRET=change_me_proxy_secret
# Alternative map format (supports multiple proxies): id1:secret1,id2:secret2
PROXY_HMAC_KEYS=
PROXY_HMAC_MAX_SKEW_SECONDS=60
PROXY_HMAC_NONCE_TTL_SECONDS=300

# Alice integration
ALICE_ENABLED=false
ALICE_ALERTS_ENABLED=false
ALICE_STALE_SENSOR_SECONDS=600
ALICE_CLIENT_ID=
ALICE_CLIENT_SECRET=
ALICE_OAUTH_REDIRECT_URI=
ALICE_OAUTH_AUTHORIZE_URL=https://oauth.yandex.ru/authorize
ALICE_OAUTH_TOKEN_URL=https://oauth.yandex.ru/token
ALICE_OAUTH_USERINFO_URL=https://login.yandex.ru/info
ALICE_SKILL_ID=
ALICE_DIALOGS_OAUTH_TOKEN=
ALICE_PROVIDER_CLIENT_ID=
ALICE_PROVIDER_CLIENT_SECRET=
ALICE_PROVIDER_REDIRECT_URIS=
ALICE_PROVIDER_AUTH_CODE_TTL_SECONDS=300
ALICE_PROVIDER_ACCESS_TOKEN_TTL_SECONDS=2592000

# Billing / plans
DEFAULT_PLAN=free
SUBSCRIPTION_PERIOD_DAYS=30
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_SECRET=

# Pin data averaging window (minutes)
PIN_DATA_AVERAGE_INTERVAL_MINUTES=5
MAX_MANUAL_ON_SECONDS=300

# Pin data cleanup policy
PIN_DATA_RETENTION_HOURS=24
PIN_DATA_CLEANUP_PERIOD_MINUTES=60
