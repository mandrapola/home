# Timeout for getaway -> server requests (ms)
CLOUD_REQUEST_TIMEOUT_MS=1500

# Local gateway HTTPS settings
GATEWAY_HTTPS_ENABLED=false
GATEWAY_HTTPS_PORT=3443
GATEWAY_HTTPS_CERT_PATH=/etc/ssl/custom/gateway.crt
GATEWAY_HTTPS_KEY_PATH=/etc/ssl/private/gateway.key

# HMAC between getaway (proxy) and server
PROXY_HMAC_ENABLED=false
PROXY_HMAC_REQUIRED=false
PROXY_HMAC_PROXY_ID=getaway
PROXY_HMAC_SECRET=change_me_proxy_secret
# Optional multi-key format: id1:secret1,id2:secret2
PROXY_HMAC_KEYS=
PROXY_HMAC_MAX_SKEW_SECONDS=60
PROXY_HMAC_NONCE_TTL_SECONDS=300

# Pin data averaging window on server (minutes)
PIN_DATA_AVERAGE_INTERVAL_MINUTES=5
MAX_MANUAL_ON_SECONDS=300
PIN_DATA_RETENTION_HOURS=24
PIN_DATA_CLEANUP_PERIOD_MINUTES=60
