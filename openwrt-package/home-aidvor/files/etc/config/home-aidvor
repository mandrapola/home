config home-aidvor 'main'
  option enabled '1'
  option port '3001'
  option cloud_base_url 'https://home.aidvor.ru'
  option cloud_health_path '/api/ping'
  option cloud_report_path '/api/controller/report'
  option cloud_settings_path_template '/api/controllers/{id}/settings'
  option heartbeat_interval_ms '5000'
  option cloud_request_timeout_ms '1500'
  option storage_check_interval_ms '10000'
  option storage_path '/tmp/home-openwrt-storage'
  option manual_pins 'D3,D5,D6,D9'
  option manual_pin_invert ''
  option default_send_interval_seconds '5'
  option hmac_enabled '1'
  option proxy_id 'getaway'
  option proxy_secret 'change_me_proxy_secret'
  option https_enabled '0'
  option https_port '3443'
  option https_cert_path '/etc/ssl/custom/gateway.crt'
  option https_key_path '/etc/ssl/private/gateway.key'
