#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

APP_DIR="/opt/home-openwrt"
APP_ENTRY="$APP_DIR/src/server.js"
APP_ENV="$APP_DIR/.env"
NODE_BIN="/usr/bin/node"

start_service() {
  procd_open_instance
  procd_set_param command /bin/sh -c "set -a; [ -f '$APP_ENV' ] && . '$APP_ENV'; set +a; cd '$APP_DIR' && exec '$NODE_BIN' '$APP_ENTRY'"
  procd_set_param respawn 5 10 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

stop_service() {
  :
}
