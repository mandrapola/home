#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

APP_DIR="/opt/home-openwrt"
APP_ENTRY="$APP_DIR/src/server.js"
APP_ENV_LEGACY="$APP_DIR/.env"
APP_ENV_RUNTIME="/var/etc/home-aidvor.env"
NODE_BIN="/usr/bin/node"
UCI_PACKAGE="home-aidvor"

. /lib/functions.sh

to_env_bool() {
  case "$(echo "$1" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) echo "true" ;;
    *) echo "false" ;;
  esac
}

read_uci_value() {
  local option="$1"
  local default="$2"
  local value
  config_get value "main" "$option" "$default"
  echo "$value"
}

generate_runtime_env() {
  local enabled port cloud_base_url cloud_health_path cloud_report_path cloud_settings_path_template
  local heartbeat_interval_ms cloud_request_timeout_ms storage_check_interval_ms storage_path
  local manual_pins manual_pin_invert default_send_interval_seconds
  local hmac_enabled proxy_id proxy_secret
  local https_enabled https_port https_cert_path https_key_path

  config_load "$UCI_PACKAGE" || return 0

  enabled="$(read_uci_value enabled 1)"
  port="$(read_uci_value port 3001)"
  cloud_base_url="$(read_uci_value cloud_base_url "")"
  cloud_health_path="$(read_uci_value cloud_health_path "/api/ping")"
  cloud_report_path="$(read_uci_value cloud_report_path "/api/controller/report")"
  cloud_settings_path_template="$(read_uci_value cloud_settings_path_template "/api/controllers/{id}/settings")"
  heartbeat_interval_ms="$(read_uci_value heartbeat_interval_ms 5000)"
  cloud_request_timeout_ms="$(read_uci_value cloud_request_timeout_ms 1500)"
  storage_check_interval_ms="$(read_uci_value storage_check_interval_ms 10000)"
  storage_path="$(read_uci_value storage_path "/tmp/home-openwrt-storage")"
  manual_pins="$(read_uci_value manual_pins "D3,D5,D6,D9")"
  manual_pin_invert="$(read_uci_value manual_pin_invert "")"
  default_send_interval_seconds="$(read_uci_value default_send_interval_seconds 5)"
  hmac_enabled="$(to_env_bool "$(read_uci_value hmac_enabled 0)")"
  proxy_id="$(read_uci_value proxy_id getaway)"
  proxy_secret="$(read_uci_value proxy_secret "")"
  https_enabled="$(to_env_bool "$(read_uci_value https_enabled 0)")"
  https_port="$(read_uci_value https_port 3443)"
  https_cert_path="$(read_uci_value https_cert_path "/etc/ssl/custom/gateway.crt")"
  https_key_path="$(read_uci_value https_key_path "/etc/ssl/private/gateway.key")"

  mkdir -p "$(dirname "$APP_ENV_RUNTIME")"
  cat >"$APP_ENV_RUNTIME" <<EOF
PORT=$port
CLOUD_BASE_URL=$cloud_base_url
CLOUD_HEALTH_PATH=$cloud_health_path
CLOUD_REPORT_PATH=$cloud_report_path
CLOUD_SETTINGS_PATH_TEMPLATE=$cloud_settings_path_template
HEARTBEAT_INTERVAL_MS=$heartbeat_interval_ms
CLOUD_REQUEST_TIMEOUT_MS=$cloud_request_timeout_ms
STORAGE_CHECK_INTERVAL_MS=$storage_check_interval_ms
STORAGE_PATH=$storage_path
MANUAL_PINS=$manual_pins
MANUAL_PIN_INVERT=$manual_pin_invert
DEFAULT_SEND_INTERVAL_SECONDS=$default_send_interval_seconds
PROXY_HMAC_ENABLED=$hmac_enabled
PROXY_HMAC_PROXY_ID=$proxy_id
PROXY_HMAC_SECRET=$proxy_secret
GATEWAY_HTTPS_ENABLED=$https_enabled
GATEWAY_HTTPS_PORT=$https_port
GATEWAY_HTTPS_CERT_PATH=$https_cert_path
GATEWAY_HTTPS_KEY_PATH=$https_key_path
EOF

  [ "$enabled" = "1" ] || [ "$(echo "$enabled" | tr '[:upper:]' '[:lower:]')" = "true" ] || return 1
  return 0
}

start_service() {
  if ! generate_runtime_env; then
    logger -t home-aidvor "disabled via UCI ($UCI_PACKAGE.main.enabled)"
    return 0
  fi

  procd_open_instance
  procd_set_param command /bin/sh -c "set -a; [ -f '$APP_ENV_LEGACY' ] && . '$APP_ENV_LEGACY'; [ -f '$APP_ENV_RUNTIME' ] && . '$APP_ENV_RUNTIME'; set +a; cd '$APP_DIR' && exec '$NODE_BIN' '$APP_ENTRY'"
  procd_set_param respawn 5 10 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  stop
  start
}

service_triggers() {
  procd_add_reload_trigger "$UCI_PACKAGE"
}

stop_service() {
  :
}
