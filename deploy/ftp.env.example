FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password

# Директория на хостинге, куда выкладывается php-app
FTP_REMOTE_DIR=/www/your-domain.ru

# true для FTPS, false для обычного FTP
FTP_SSL=false

# Тюнинг скорости lftp
FTP_PARALLEL=4
FTP_PGET=4
FTP_CONNECTION_LIMIT=8
